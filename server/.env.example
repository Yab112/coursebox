NODE_ENV=development
PORT=4000
# Postgres connection (Supabase: use the session pooler URL, URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_SSL=false
DATABASE_SCHEMA=coursebox
RUN_MIGRATIONS=true
# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# "local" (disk, for dev/self-hosting) or "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
PUBLIC_API_URL=http://localhost:4000
SIGNING_SECRET=change-me-to-a-long-random-string

S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # optional: MinIO / Cloudflare R2

COURSE_LIMIT=2
MAX_COURSE_BYTES=2147483648
MAX_FILE_BYTES=5368709120
MAX_FILES_PER_COURSE=5000
SESSION_TTL_DAYS=30
STALE_UPLOAD_HOURS=24
